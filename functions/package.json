{
  "name": "functions",
  "description": "Firebase Cloud Functions for ZakatApp Push Notifications",
  "scripts": {
    "watch": "node watch_and_push.js",
    "send": "node send_push_notification.js",
    "lint": "eslint .",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "node watch_and_push.js",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "18"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0"
  },
  "devDependencies": {
    "eslint": "^8.9.0"
  },
  "private": true
}
